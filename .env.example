# =============================================================
# VSA EduAI — copie para .env e ajuste
#   cp .env.example .env
# No Dokploy, defina na aba Environment do serviço.
# =============================================================

# Domínio (Traefik) — wildcard *.vsanexus.com já cobre
ESCOLA_DOMAIN=escola.vsanexus.com

# Identidade do aluno
ALUNO_NOME=Explorador

# Senhas (gate do app)
ALUNO_SENHA=troque-a-senha-do-aluno
PAI_SENHA=troque-a-senha-do-pai

# Link da quest Linux (módulo Programação abre aqui)
TERMINAL_URL=https://vgtux.vsanexus.com

# XP necessário por nível
XP_POR_NIVEL=200

# ── Gate do Tux + limites diários ────────────────────────────
# Trilha obrigatória: 1 missão concluída em cada matéria abaixo libera o Tux
TRILHA_MATERIAS=matematica,portugues,ciencias
# Máximo de atividades de leitura por dia
ATIVIDADES_POR_DIA=2
# Tempo de tela do Tux por dia (minutos), janela a partir da 1ª abertura
TUX_MINUTOS=60
