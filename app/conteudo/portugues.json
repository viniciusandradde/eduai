         "explicacao": "Ela encontrou seu amigo Pedro."},
        {"id": "i4", "tipo": "vf", "enunciado": "Joana acordou tarde.",
         "resposta": false, "explicacao": "O texto diz que ela 'acordou cedo'."},
        {"id": "i5", "tipo": "lacuna", "enunciado": "Joana foi à ___ comprar pão.",
         "resposta": "padaria", "explicacao": "Ela foi à padaria."}
      ]
    },
