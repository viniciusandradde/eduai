{
  "id": "matematica",
  "nome": "Matemática",
  "icone": "🔢",
  "cor": "#2563eb",
  "ordem": 1,
  "missoes": [
    {
      "id": "fracoes",
      "titulo": "Frações",
      "descricao": "Somar, comparar e simplificar frações.",
      "exercicios": [
        {"id": "f1", "tipo": "multipla", "enunciado": "Quanto é 1/2 + 1/4?",
         "opcoes": ["1/6", "2/6", "3/4", "1/3"], "correta": 2,
         "explicacao": "1/2 = 2/4, então 2/4 + 1/4 = 3/4."},
        {"id": "f2", "tipo": "numerica", "enunciado": "Quanto é 3/4 de 20?",
         "resposta": 15, "explicacao": "20 ÷ 4 = 5; 5 × 3 = 15."},
        {"id": "f3", "tipo": "vf", "enunciado": "A fração 2/4 é igual a 1/2.",
         "resposta": true, "explicacao": "Dividindo em cima e embaixo por 2: 2/4 = 1/2."},
        {"id": "f4", "tipo": "multipla", "enunciado": "Qual é maior?",
         "opcoes": ["2/3", "3/5", "São iguais"], "correta": 0,
         "explicacao": "2/3 ≈ 0,67 e 3/5 = 0,6. Logo 2/3 é maior."},
        {"id": "f5", "tipo": "lacuna", "enunciado": "A fração 5/10 simplificada é 1/___",
         "resposta": "2", "explicacao": "5/10 dividido por 5 = 1/2."}
      ]
    },
    {
      "id": "porcentagem",
      "titulo": "Porcentagem",
      "descricao": "Calcular porcentagens e descontos.",
      "exercicios": [
        {"id": "p1", "tipo": "numerica", "enunciado": "Quanto é 10% de 200?",
         "resposta": 20, "explicacao": "10% = 0,10; 0,10 × 200 = 20."},
        {"id": "p2", "tipo": "numerica", "enunciado": "Quanto é 25% de 80?",
         "resposta": 20, "explicacao": "25% é 1/4; 80 ÷ 4 = 20."},
        {"id": "p3", "tipo": "multipla", "enunciado": "Um produto de R$ 50 com 20% de desconto custa:",
         "opcoes": ["R$ 30", "R$ 40", "R$ 45", "R$ 10"], "correta": 1,
         "explicacao": "20% de 50 = 10; 50 − 10 = 40."},
        {"id": "p4", "tipo": "vf", "enunciado": "50% é o mesmo que a metade.",
         "resposta": true, "explicacao": "50% = 50/100 = 1/2 = metade."},
        {"id": "p5", "tipo": "numerica", "enunciado": "Se 30 vale 100%, quanto vale 50%?",
         "resposta": 15, "explicacao": "Metade de 30 é 15."}
      ]
    },
    {
      "id": "equacoes",
      "titulo": "Equações do 1º grau",
      "descricao": "Descobrir o valor de x.",
      "exercicios": [
        {"id": "e1", "tipo": "numerica", "enunciado": "x + 5 = 12. Qual o valor de x?",
         "resposta": 7, "explicacao": "x = 12 − 5 = 7."},
        {"id": "e2", "tipo": "numerica", "enunciado": "2x = 10. Qual o valor de x?",
         "resposta": 5, "explicacao": "x = 10 ÷ 2 = 5."},
        {"id": "e3", "tipo": "numerica", "enunciado": "3x − 6 = 9. Qual o valor de x?",
         "resposta": 5, "explicacao": "3x = 15, então x = 5."},
        {"id": "e4", "tipo": "multipla", "enunciado": "x ÷ 2 = 4. Qual o valor de x?",
         "opcoes": ["2", "6", "8", "16"], "correta": 2,
         "explicacao": "x = 4 × 2 = 8."},
        {"id": "e5", "tipo": "vf", "enunciado": "Na equação x + 3 = 3, o valor de x é 0.",
         "resposta": true, "explicacao": "x = 3 − 3 = 0."}
      ]
    },
    {
      "id": "decimais",
      "titulo": "Números decimais (5º ano)",
      "descricao": "Ler, comparar e somar números com vírgula.",
      "exercicios": [
        {"id": "d1", "tipo": "multipla", "enunciado": "Como se lê o número 0,5?",
         "opcoes": ["cinco", "cinco décimos", "cinquenta"], "correta": 1,
         "explicacao": "0,5 = cinco décimos = meio."},
        {"id": "d2", "tipo": "numerica", "enunciado": "Quanto é 0,5 + 0,5?",
         "resposta": 1, "explicacao": "Meio + meio = 1 inteiro."},
        {"id": "d3", "tipo": "multipla", "enunciado": "Qual número é maior?",
         "opcoes": ["0,7", "0,07", "São iguais"], "correta": 0,
         "explicacao": "0,7 (sete décimos) é maior que 0,07 (sete centésimos)."},
        {"id": "d4", "tipo": "vf", "enunciado": "0,25 é o mesmo que a fração 1/4.",
         "resposta": true, "explicacao": "Um quarto = 0,25."},
        {"id": "d5", "tipo": "numerica", "enunciado": "Quanto é 1,2 + 0,8?",
         "resposta": 2, "explicacao": "1,2 + 0,8 = 2,0."}
      ]
    },
    {
      "id": "geometria",
      "titulo": "Geometria e perímetro (5º ano)",
      "descricao": "Formas, lados e perímetro de figuras.",
      "exercicios": [
        {"id": "g1", "tipo": "numerica", "enunciado": "Qual o perímetro de um quadrado de lado 5 cm? (em cm)",
         "resposta": 20, "explicacao": "Perímetro = 4 × 5 = 20 cm."},
        {"id": "g2", "tipo": "multipla", "enunciado": "Quantos lados tem um hexágono?",
         "opcoes": ["5", "6", "8"], "correta": 1, "explicacao": "Hexágono tem 6 lados."},
        {"id": "g3", "tipo": "numerica", "enunciado": "Perímetro de um retângulo de 4 cm por 6 cm? (em cm)",
         "resposta": 20, "explicacao": "4 + 6 + 4 + 6 = 20 cm."},
        {"id": "g4", "tipo": "vf", "enunciado": "Um quadrado tem 4 ângulos retos (de 90°).",
         "resposta": true, "explicacao": "Todos os ângulos do quadrado são retos."},
        {"id": "g5", "tipo": "multipla", "enunciado": "Qual figura tem 3 lados?",
         "opcoes": ["Triângulo", "Quadrado", "Círculo"], "correta": 0,
         "explicacao": "O triângulo tem 3 lados."}
      ]
    },
    {
      "id": "dinheiro_medidas",
      "titulo": "Dinheiro e medidas (5º ano)",
      "descricao": "Sistema monetário e unidades de medida.",
      "exercicios": [
        {"id": "dm1", "tipo": "numerica", "enunciado": "Quantos centavos há em 1 real?",
         "resposta": 100, "explicacao": "R$ 1,00 = 100 centavos."},
        {"id": "dm2", "tipo": "multipla", "enunciado": "Quanto é R$ 2,50 + R$ 1,50?",
         "opcoes": ["R$ 3,00", "R$ 4,00", "R$ 4,50"], "correta": 1,
         "explicacao": "2,50 + 1,50 = R$ 4,00."},
        {"id": "dm3", "tipo": "numerica", "enunciado": "Quantos minutos tem 1 hora?",
         "resposta": 60, "explicacao": "1 hora = 60 minutos."},
        {"id": "dm4", "tipo": "numerica", "enunciado": "Quantos centímetros tem 1 metro?",
         "resposta": 100, "explicacao": "1 m = 100 cm."},
        {"id": "dm5", "tipo": "multipla", "enunciado": "Quantos metros tem 1 quilômetro?",
         "opcoes": ["100", "1000", "10000"], "correta": 1, "explicacao": "1 km = 1000 m."}
      ]
    }
  ]
}
